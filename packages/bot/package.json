{
  "name": "bot",
  "description": "Alwatr Telegram Notify Microservice, Distributed simple and fast telegram notify nanoservice.",
  "version": "0.1.0",
  "author": "S. Ali Mihandoost <ali.mihandoost@gmail.com>",
  "bugs": "https://github.com/Alwatr/notifier/issues",
  "dependencies": {
    "grammy": "^1.38.3"
  },
  "devDependencies": {
    "@alwatr/nano-build": "^6.3.5",
    "@alwatr/prettier-config": "^5.0.5",
    "@alwatr/tsconfig-base": "^6.0.3",
    "@alwatr/type-helper": "^6.1.5",
    "@types/node": "^24.9.1",
    "alwatr": "^5.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.16.0",
    "yarn": ">=4.0.0"
  },
  "homepage": "https://github.com/Alwatr/notifier#readme",
  "license": "AGPL-3.0-only",
  "nano-build": {
    "external": [
      "grammy"
    ],
    "entryPoints": [
      "./src/initialize.ts",
      "./src/migration.ts",
      "./src/start.ts"
    ],
    "target": "node22",
    "splitting": true
  },
  "prettier": "@alwatr/prettier-config",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Alwatr/notifier",
    "directory": "packages/api"
  },
  "scripts": {
    "b": "yarn run build",
    "build": "yarn run build:ts && yarn run build:es",
    "build:es": "nano-build --preset=microservice",
    "build:ts": "tsc --build",
    "c": "yarn run clean",
    "cb": "yarn run clean && yarn run build",
    "clean": "rm -rfv dist *.tsbuildinfo",
    "cw": "yarn run clean && yarn run watch",
    "d": "yarn run build:es && DEBUG=1 yarn node",
    "initialize": "yarn build && initializeMode=1 yarn node --enable-source-maps dist/initialize.mjs",
    "migration": "yarn build && yarn node --enable-source-maps dist/migration.mjs",
    "s": "yarn run start",
    "serve": "yarn node --enable-source-maps dist/start.mjs",
    "serve:debug": "yarn node --inspect --enable-source-maps dist/start.mjs",
    "start": "yarn build && yarn serve",
    "w": "yarn run watch",
    "watch": "yarn run build --watch"
  },
  "type": "module"
}
